{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policies",
  "description": "governance/policies.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policies"
  ],
  "properties": {
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "statement",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "uniqueItems": true
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "approved_by": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "reference": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
