{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maketools-company/datagovernance-as-code/schemas/glossary.schema.json",
  "title": "governance/glossary/{domain}.yaml: business terms of a domain",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "terms"],
  "properties": {
    "domain": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "definition", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "name": {"type": "string"},
          "definition": {"type": "string", "minLength": 10},
          "synonyms": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["draft", "approved", "deprecated"]}
        }
      }
    }
  }
}
