{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glossary",
  "description": "domains/<id>/glossary.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "terms"
  ],
  "properties": {
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "definition",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "synonyms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "draft",
              "approved",
              "deprecated"
            ]
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
            }
          }
        }
      }
    }
  }
}
