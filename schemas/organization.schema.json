{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Organization",
  "description": "governance/organization.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "roles"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "object",
      "description": "Organization role id -> person.",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 3,
        "description": "Work email or identity-provider ID."
      }
    },
    "governance_team": {
      "type": "string",
      "pattern": "^@"
    }
  }
}
