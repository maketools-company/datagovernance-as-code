{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roles",
  "description": "governance/roles.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "roles"
  ],
  "properties": {
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "scope",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "domain",
              "organization"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "approves": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "governance",
                "domain",
                "glossary",
                "products"
              ]
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
