{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Classification",
  "description": "governance/classification.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "levels"
  ],
  "properties": {
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "reviewers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "uniqueItems": true
          },
          "dpv": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
