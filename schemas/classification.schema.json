{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maketools/datagovernance-as-code/schemas/classification.schema.json",
  "title": "governance/classification.yaml: sensitivity levels",
  "type": "object",
  "additionalProperties": false,
  "required": ["levels"],
  "properties": {
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rank", "name", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "rank": {"type": "integer", "minimum": 1},
          "name": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    }
  }
}
