{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teams",
  "description": "governance/teams.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "teams"
  ],
  "properties": {
    "teams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "lead": {
            "type": "string",
            "minLength": 3,
            "description": "Work email or identity-provider ID."
          },
          "contact": {
            "type": "string",
            "minLength": 1
          },
          "github": {
            "type": "string",
            "pattern": "^@"
          }
        }
      }
    }
  }
}
