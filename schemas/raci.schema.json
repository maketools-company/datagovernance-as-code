{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RACI",
  "description": "governance/raci.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activities"
  ],
  "properties": {
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "raci"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "raci": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "additionalProperties": {
              "enum": [
                "R",
                "A",
                "C",
                "I"
              ]
            }
          }
        }
      }
    }
  }
}
