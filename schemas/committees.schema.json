{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Committees",
  "description": "governance/committees.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "committees"
  ],
  "properties": {
    "committees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "purpose",
          "chair",
          "members"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "chair": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "uniqueItems": true
          },
          "meets": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
