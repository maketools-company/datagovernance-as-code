{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Domain",
  "description": "domains/<id>/domain.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "roles"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "parent": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "roles": {
      "type": "object",
      "description": "Domain role id -> person.",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 3,
        "description": "Work email or identity-provider ID."
      }
    }
  }
}
